# Copy to .env and fill in.  (.env is git-ignored.)

# --- Target: the ONLY host the agent may touch ---
# Run Brandon's lab locally (see README) and point here, e.g.:
TARGET_URL=https://thinkcyber-target.kindwater-1bc2a0f1.eastus.azurecontainerapps.io

# If the target is behind a login/splash (the ThinkCyber lab uses an event
# password), log in once in your browser, copy the Cookie header from devtools,
# and paste it here so the agent's requests are authenticated. Leave blank if open.
TARGET_COOKIE=session=eyJfcGVybWFuZW50Ijp0cnVlLCJldmVudF9hdXRob3JpemVkIjp0cnVlfQ.auTY0A.8BDC4Bfqy6szxogJaOY_y-gtH9g


# --- Model: from your Foundry deployment's Details tab ---
# Paste the resource host (the code appends /openai/v1/ for you). Pasting the
# full Target URI works too. No api-version needed on the v1 endpoint.
AZURE_OPENAI_ENDPOINT=https://foundry-podtential-615653.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# --- Optional limits ---
MAX_ITERATIONS=25
TOOL_TIMEOUT=120
OUTPUT_TRUNC=4000
REPORT_DIR=reports
